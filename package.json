{
  "name": "breadandbutter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "dev:worker": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "cf:types": "wrangler types",
    "db:create": "wrangler d1 create breadandbutter-feedback",
    "db:migrate": "wrangler d1 execute breadandbutter-feedback --remote --file=schema.sql",
    "db:migrate:local": "wrangler d1 execute breadandbutter-feedback --local --file=schema.sql",
    "feedback": "wrangler d1 execute breadandbutter-feedback --remote --command \"SELECT datetime(ts/1000,'unixepoch') AS time, category, url, country, text FROM feedback ORDER BY ts DESC\"",
    "feedback:tail": "wrangler d1 execute breadandbutter-feedback --remote --command \"SELECT datetime(ts/1000,'unixepoch') AS time, category, text FROM feedback ORDER BY ts DESC LIMIT 10\"",
    "feedback:json": "wrangler d1 execute breadandbutter-feedback --remote --json --command \"SELECT * FROM feedback ORDER BY ts DESC\""
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.29.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "wrangler": "^4.119.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "workerd@1.20260801.1": true
  }
}
